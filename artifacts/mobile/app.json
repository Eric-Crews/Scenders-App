{
  "expo": {
    "name": "Scenders",
    "slug": "scenders",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scenders",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.scenders.ride",
      "associatedDomains": [
        "applinks:scenders.com"
      ],
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Scenders uses your location to show your position and record your ride.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Scenders keeps route guidance and off-route alerts working while your phone is locked or in your pocket.",
        "NSCameraUsageDescription": "Scenders uses the camera so you can attach a photo to a waypoint.",
        "NSPhotoLibraryUsageDescription": "Scenders uses your photo library so you can attach existing photos to waypoints.",
        "NSPhotoLibraryAddUsageDescription": "Scenders can save waypoint photos to your Camera Roll.",
        "NSContactsUsageDescription": "Scenders can choose a trusted contact to receive your private live ride link.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.scenders.ride",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D2691E"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "scenders.com",
              "pathPrefix": "/where-to-ride/"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/scenders-s-badge.png",
          "resizeMode": "contain",
          "backgroundColor": "#090909",
          "dark": {
            "image": "./assets/images/scenders-s-badge.png",
            "backgroundColor": "#090909"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scenders uses your location to show your position and record your ride.",
          "locationAlwaysAndWhenInUsePermission": "Scenders keeps route guidance and off-route alerts working while your phone is locked or in your pocket.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Scenders uses your photo library so you can attach existing photos to waypoints.",
          "cameraPermission": "Scenders uses the camera so you can attach a photo to a waypoint."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "07278263-02a2-49df-80eb-dd998f20de86"
      }
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "owner": "supportal"
  }
}
