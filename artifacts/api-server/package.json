{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:community-redaction": "esbuild src/lib/communityMapSource.test.ts --bundle --platform=node --format=esm --outfile=/tmp/mapper-community-map-source.test.mjs && node --test /tmp/mapper-community-map-source.test.mjs",
    "test:live-activities": "esbuild src/routes/liveActivities.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/mapper-live-activities.test.cjs && node --test /tmp/mapper-live-activities.test.cjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@mapbox/togeojson": "^0.16.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/geo": "workspace:*",
    "@xmldom/xmldom": "^0.9.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "openai": "^6.39.1",
    "openid-client": "^6.8.4",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
