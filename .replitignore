# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Development-only caches and dependencies are recreated during the publish
# build. The API production bundle includes its runtime dependencies.
.cache
node_modules
artifacts/*/node_modules

# Local release output is already copied into the site's public download path.
artifacts/mobile/.release-artifacts

# Git history is not needed at runtime.
.git
